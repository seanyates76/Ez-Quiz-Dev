# Files and directories to EXCLUDE from the public mirror
# Adjust as needed. Glob patterns are supported.

# VCS/CI
.git/
.github/
.gitignore

# Local artifacts
node_modules/
.DS_Store
.artifacts/
.ezq/
files/
.netlify/

# Docs and meta not needed for deploys
docs/
issues/
tests/
scripts/
agents.md
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
RELEASE_NOTES.md
BETA_DOCUMENTATION.md
LAZY_EXPLANATIONS.md

# Tests and internal tooling (uncomment if desired)
# tests/
# scripts/
# netlify/
# docs/

# Temporary or editor files
*.swp
*.log
.env
.env.*
